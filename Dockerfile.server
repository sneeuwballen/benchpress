# build stage: c-cube ci image (OCaml 5.5, dune 3.25 preinstalled)
FROM ghcr.io/c-cube/c-cube-commmon/ci-5.5:latest AS build
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
      libsqlite3-dev libcurl4-gnutls-dev rsync
WORKDIR /src
COPY *.opam ./
RUN opam pin add -y -n . && \
    opam install -t . --deps-only -y
COPY . .
RUN opam exec -- dune build --profile=release src/server/benchpress_server.exe && \
    strip _build/default/src/server/benchpress_server.exe

# runtime: debian trixie (glibc >= the build image's; bookworm is too old)
FROM debian:trixie AS prod
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
      libsqlite3-0 libcurl3-gnutls libjemalloc2 ca-certificates zstd && \
    rm -rf /var/lib/apt/lists/*
COPY docker/benchpress-server.conf.yaml /config/benchpress/conf.yaml
COPY --from=build /src/_build/default/src/server/benchpress_server.exe \
     /usr/local/bin/benchpress-server
ENV XDG_DATA_HOME=/data XDG_CONFIG_HOME=/config
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/benchpress-server"]
CMD ["serve", "-d", "true"]
